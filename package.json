{
  "name": "kaki-finder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-typescript.mjs test",
    "db:prepare": "node scripts/prepare-db.mjs",
    "db:check": "node --env-file-if-exists=.env.local scripts/run-typescript.mjs db-check",
    "db:verify": "node --env-file-if-exists=.env.local scripts/run-typescript.mjs db-verify",
    "test:http": "node --env-file-if-exists=.env.local scripts/http-smoke.mjs",
    "test:auth": "node --env-file-if-exists=.env.local scripts/auth-smoke.mjs",
    "test:connections": "node --env-file-if-exists=.env.local scripts/connections-smoke.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.6",
    "@supabase/supabase-js": "2.115.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "autoprefixer": "10.5.5",
    "next": "16.3.4",
    "postcss": "8.5.28",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "zod": "4.5.4"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "4.3.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0"
  }
}
