# Copy this file to .env.local. Never commit real keys.
DATA_SOURCE=fixtures

# Server-only database access.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Publishable values for the cookie-aware account client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set to your exact HTTPS site origin on Vercel. Used for auth email links.
APP_URL=http://127.0.0.1:3100
