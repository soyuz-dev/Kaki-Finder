# No keys are required for the scaffold. Never commit .env.local.
# Reserved for the future storage adapters.
DATA_SOURCE=fixtures

# Server only. Never prefix a secret with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Reserved for future cookie-aware Supabase Auth clients.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
